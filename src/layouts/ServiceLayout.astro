---
/**
 * ServiceLayout.astro — template for /services/[service] pages.
 *
 * DATA-DRIVEN: it takes a Service object and derives everything (title,
 * breadcrumbs, internal links, schema) from the catalog plus the rich page copy
 * in service-content.ts. The page file just hands over the data, so all four
 * service pages share identical structure and a new service needs zero template
 * work. Nothing about a service is written here. If a fact belongs to a service,
 * it lives in services.ts or service-content.ts.
 *
 * Section order (1 to 10): hero, business outcome, what is included, how it
 * supports the system, sub-services, process, pricing, who it is for, FAQs with
 * FAQPage schema, final CTA. Emits Service + Offer + FAQPage JSON-LD alongside
 * the BreadcrumbList schema from Breadcrumbs.astro.
 *
 * House style for visible prose on this page: no em dashes and no semicolons.
 */
import BaseLayout from './BaseLayout.astro';
import Breadcrumbs from '../components/Breadcrumbs.astro';
import InternalLinks from '../components/InternalLinks.astro';
import ServiceIcon from '../components/ServiceIcon.astro';
import { BUSINESS, SITE } from '../config/site';
import { formatStartingPrice, offerPriceSpecification, type Service } from '../data/services';
import {
  getServiceContent,
  getServiceFaqs,
  serviceProcess,
  whyChoose,
  serviceTrustBullets,
} from '../data/service-content';
import { relatedServices, locationsForService, subServicesForCategory } from '../lib/links';
import { serviceUrl, cityUrl, subServiceUrl, absoluteUrl, contactUrl } from '../lib/urls';

interface Props {
  service: Service;
}

const { service } = Astro.props;
const content = getServiceContent(service.slug);
const faqs = getServiceFaqs(service.slug);
const priceLabel = formatStartingPrice(service.startingPrice);

// These are the canonical Mesa service pages, so the title targets Mesa.
const title = `${service.name} in Mesa, AZ`;
const description = service.description;

const crumbs = [
  { name: 'Home', href: '/' },
  { name: 'Services', href: '/services' },
  { name: service.name },
];

// The two sub-services in this category, rendered as cards in section 5.
const subServices = subServicesForCategory(service.slug);

// The other three services, pulled from the catalog so names, taglines, and
// links cannot drift from services.ts.
const siblingServices = relatedServices(service.slug, 3);

// "Available in these areas" links to the city pages. There are no per-city
// service pages, so the city page itself is the destination.
const areaLinks = locationsForService(service.slug).map((loc) => ({
  label: `${loc.city}, ${loc.region}`,
  href: cityUrl(loc.slug),
}));

// Service structured data, referencing the primary business node. The Offer
// exposes the same entry price the hero shows, so markup and copy cannot drift.
// The price is carried by priceSpecification (a minPrice, plus a monthly billing
// period for retainers) rather than a flat `price`, because every number we
// publish is a starting point rather than a fixed cost. See offerPriceSpecification.
const serviceSchema = {
  '@context': 'https://schema.org',
  '@type': 'Service',
  serviceType: service.name,
  provider: { '@id': `${SITE.url}/#business` },
  areaServed: BUSINESS.areaServed,
  description: service.description,
  url: absoluteUrl(serviceUrl(service.slug)),
  offers: {
    '@type': 'Offer',
    priceCurrency: service.startingPrice.currency,
    availability: 'https://schema.org/InStock',
    url: absoluteUrl(serviceUrl(service.slug)),
    priceSpecification: offerPriceSpecification(service.startingPrice),
  },
};

// FAQPage schema, covering exactly the FAQs visible on this page.
const faqSchema = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: faqs.map((f) => ({
    '@type': 'Question',
    name: f.question,
    acceptedAnswer: { '@type': 'Answer', text: f.answer },
  })),
};
---

<BaseLayout {title} {description}>
  <article class="container page">
    <Breadcrumbs items={crumbs} />

    {/* 1. Hero */}
    <header class="page-hero service-hero">
      <p class="eyebrow">
        <ServiceIcon name={service.icon} class="eyebrow-icon" />
        {service.shortName}
      </p>
      <h1>{service.heroTitle}</h1>
      <p class="lede">{service.heroSubtitle}</p>
      <p class="starting-price">Starting at <strong>{priceLabel}</strong></p>
      <div class="hero-actions">
        <a class="button primary" href={contactUrl('strategy')}>Schedule a Strategy Call</a>
        <a class="button outline" href={contactUrl('audit')}>Get a Free SEO Audit</a>
      </div>
      <ul class="hero-trust">
        {serviceTrustBullets.map((b) => <li>{b}</li>)}
      </ul>
    </header>

    <div class="service-flow">
      {/* 2. Business outcome: the lead-generation problem this solves. */}
      <section class="service-section">
        <h2>The lead problem this solves</h2>
        <p class="intro-line">{service.intro}</p>
        <div class="copy-stack">
          {(content?.overview ?? []).map((p) => <p>{p}</p>)}
        </div>

        {content && content.problems.length > 0 && (
          <div class="problem-grid">
            {content.problems.map((p) => (
              <div class="problem-card">
                <h3>Problem</h3>
                <p>{p.problem}</p>
                <h3>Solution</h3>
                <p>{p.solution}</p>
              </div>
            ))}
          </div>
        )}

        {content && content.reasons.length > 0 && (
          <>
            <h3>Common reasons owners call us</h3>
            <ul class="pill-list">
              {content.reasons.map((r) => <li>{r}</li>)}
            </ul>
          </>
        )}
      </section>

      {/* 3. What is included: outcomes first, then deliverables, then detail. */}
      <section class="service-section">
        <h2>What is included</h2>

        <h3>What you get out of it</h3>
        <ul class="check-list">
          {service.benefits.map((b) => <li>{b}</li>)}
        </ul>

        <h3>What we do</h3>
        <ul class="check-list">
          {service.features.map((f) => <li>{f}</li>)}
        </ul>

        {content && content.detailGroups.length > 0 && (
          <div class="detail-grid">
            {content.detailGroups.map((group) => (
              <div class="detail-card">
                <h3>{group.title}</h3>
                <ul>
                  {group.items.map((item) => <li>{item}</li>)}
                </ul>
              </div>
            ))}
          </div>
        )}
      </section>

      {/* 4. How this service supports the larger system. */}
      {content?.systemRole && (
        <section class="service-section">
          <h2>How {service.name} fits the larger system</h2>
          <p>{content.systemRole}</p>
          <h3>The channels it works with</h3>
          <div class="detail-grid">
            {siblingServices.map((s) => (
              <div class="detail-card">
                <h3>{s.name}</h3>
                <p>{s.tagline}</p>
                <a href={serviceUrl(s.slug)}>Explore {s.name}</a>
              </div>
            ))}
          </div>
        </section>
      )}

      {/* 5. Sub-services. */}
      {subServices.length > 0 && (
        <section class="service-section">
          <h2>{service.name} services</h2>
          <div class="detail-grid">
            {subServices.map((sub) => (
              <div class="detail-card">
                <h3>{sub.name}</h3>
                <p>{sub.tagline}</p>
                <ul>
                  {sub.features.slice(0, 3).map((f) => <li>{f}</li>)}
                </ul>
                <a href={subServiceUrl(service.slug, sub.slug)}>Explore {sub.name}</a>
              </div>
            ))}
          </div>
        </section>
      )}

      {/* 6. Process. */}
      <section class="service-section">
        <h2>How we get you more booked jobs</h2>
        <ol class="number-list">
          {serviceProcess.map((step) => (
            <li>
              <h3>{step.title}</h3>
              <p>{step.text}</p>
            </li>
          ))}
        </ol>
      </section>

      {/* 7. Pricing guidance. */}
      <section class="service-section">
        <h2>What {service.name} costs</h2>
        <p class="intro-line">
          {service.name} starts at {priceLabel}. That is an entry point, not a quote.
        </p>
        {content?.pricingNote && <p>{content.pricingNote}</p>}
        <p>
          On a strategy call we scope the work against your market and give you a real number before
          you commit to anything.
        </p>
      </section>

      {/* 8. Who it is for. */}
      {content && content.idealFor.length > 0 && (
        <section class="service-section">
          <h2>Who {service.name} is for</h2>
          <div class="detail-grid">
            {content.idealFor.map((f) => (
              <div class="detail-card">
                <h3>{f.title}</h3>
                <p>{f.text}</p>
              </div>
            ))}
          </div>
        </section>
      )}

      {/* Scope and expectation setting. */}
      {content?.specialNote && (
        <section class="service-section">
          <div class="warning-section">
            <h3>Good to know</h3>
            <p>{content.specialNote}</p>
          </div>
        </section>
      )}

      {/* Why choose us. */}
      <section class="service-section">
        <h2>Why choose {SITE.name}</h2>
        <ul class="check-list">
          {whyChoose.map((w) => <li>{w}</li>)}
        </ul>
      </section>

      <slot />
    </div>

    <InternalLinks title="Available in these areas" links={areaLinks} />

    {/* 9. FAQs. */}
    <section class="service-section faq-block">
      <h2>{service.name} FAQs</h2>
      <div class="faq-list">
        {faqs.map((f) => (
          <details>
            <summary>{f.question}</summary>
            <p>{f.answer}</p>
          </details>
        ))}
      </div>
    </section>

    {/* 10. Final CTA. */}
    <section class="cta-band">
      <div>
        <h2>Ready for more booked jobs?</h2>
        <p>
          Book a strategy call and we will audit your visibility, your website, and your Google
          Business Profile before we speak. You will leave knowing where your leads are leaking and
          what we would fix first, whether or not you hire us.
        </p>
      </div>
      <a class="button primary" href={contactUrl('strategy')}>Schedule a Strategy Call</a>
    </section>

    <script type="application/ld+json" set:html={JSON.stringify(serviceSchema)} is:inline />
    <script type="application/ld+json" set:html={JSON.stringify(faqSchema)} is:inline />
  </article>
</BaseLayout>

<style>
  /* Icon sits inline with the eyebrow label above the h1. */
  .service-hero .eyebrow {
    display: flex;
    align-items: center;
    gap: 0.5rem;
  }

  .starting-price {
    margin: 0 0 1.25rem;
    color: var(--brand-primary-dark);
  }

  .detail-card a {
    display: inline-block;
    margin-top: 0.5rem;
    font-weight: 700;
    font-size: 0.9rem;
  }
</style>
