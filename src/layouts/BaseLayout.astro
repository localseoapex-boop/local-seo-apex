---
/**
 * BaseLayout.astro — the root HTML shell every page renders inside.
 *
 * Composes the global pieces: BaseHead (SEO meta), Navigation, Footer, and the
 * LocalBusiness schema. It forwards SEO props through to BaseHead so each page
 * controls its own title/description/canonical while inheriting one consistent
 * document structure. Page content is injected through the <slot />.
 *
 * The specialized templates (Service/City/BlogPost) build ON TOP of this layout,
 * so global concerns live here and only here.
 */
import BaseHead from '../components/BaseHead.astro';
import Navigation from '../components/Navigation.astro';
import Footer from '../components/Footer.astro';
import LocalBusinessSchema from '../components/LocalBusinessSchema.astro';
import GoogleAnalytics from '../components/GoogleAnalytics.astro';
import { SITE } from '../config/site';

interface Props {
  title: string;
  description?: string;
  image?: string;
  type?: 'website' | 'article';
  noindex?: boolean;
}

const { title, description, image, type, noindex } = Astro.props;
---

<!doctype html>
<html lang={SITE.locale}>
  <head>
    <BaseHead {title} {description} {image} {type} {noindex} />
    <LocalBusinessSchema />
    <GoogleAnalytics />
  </head>
  <body>
    <Navigation />
    <main>
      <slot />
    </main>
    <Footer />
  </body>
</html>

<style is:global>
  :root {
    --content-width: 1100px;

    /* ── Brand palette (see localseoapex_migration/branding) ── */
    --brand-primary: #000080; /* canonical navy */
    --brand-primary-dark: #00005c; /* darker navy: gradients, hovers */
    --brand-secondary: #ff7f50; /* canonical coral */
    --brand-secondary-dark: #f2662f; /* coral hover — still passes AA with navy text */
    --brand-accent: #ff7f50a6; /* coral @ 65% — overlays/accents only */
    /* Not in the brand packet. Form errors need a colour that (a) reads as an
       error and (b) passes AA on white — coral is 2.5:1 and cannot. This is the
       coral hue darkened until it passes (5.2:1). Needs brand sign-off. */
    --brand-danger: #c2410c;
    --brand-text: #3a3a3a; /* body copy (11.3:1 on white) */
    /* Brand's documented muted gray is #808080, but that is 3.95:1 on white and
       fails WCAG AA for text at any size. Darkened to the nearest gray that
       passes (5.3:1) so secondary copy stays legible. #808080 is retained below
       for NON-TEXT use only (rules, dividers, decorative marks). */
    --brand-muted: #6b6b6b;
    --brand-muted-decorative: #808080;
    --brand-border: #d6d6d6;
    --brand-footer: #575860;
    --brand-white: #ffffff;
    --brand-surface: #f7f8fa; /* page background */
    --brand-tint: #eef0f8; /* pale navy tint: alt sections, pills */
    --shadow: 0 18px 50px rgba(0, 0, 128, 0.08);

    /* ── Typography ── */
    --font-heading: 'Spectral', Georgia, 'Times New Roman', serif;
    --font-body: 'Karla', system-ui, -apple-system, 'Segoe UI', Helvetica, Arial, sans-serif;
  }
  * {
    box-sizing: border-box;
  }
  html {
    font-family: var(--font-body);
    color: var(--brand-text);
    line-height: 1.6;
    scroll-behavior: smooth;
  }
  body {
    margin: 0;
    background: var(--brand-surface);
  }
  main {
    min-height: 60vh;
  }
  a {
    color: var(--brand-primary);
  }
  h1,
  h2,
  h3,
  h4,
  h5,
  h6 {
    font-family: var(--font-heading);
    font-weight: 600;
    line-height: 1.15;
    color: var(--brand-primary);
  }
  /* Single global focus ring — visible on both light and coral surfaces. */
  :focus-visible {
    outline: 3px solid var(--brand-primary);
    outline-offset: 2px;
    border-radius: 4px;
  }
  h1 {
    font-size: clamp(2.2rem, 5vw, 3.4rem);
  }
  h2 {
    font-size: clamp(1.7rem, 3vw, 2.4rem);
  }
  img {
    max-width: 100%;
    height: auto;
  }
  .container {
    max-width: var(--content-width);
    margin: 0 auto;
    padding: 0 1rem;
  }

  /* ───────────── Shared landing-page primitives ───────────── */
  .page {
    padding: 0 1rem 3rem;
  }
  .page-hero {
    padding: 1.75rem 0 0;
  }
  .page-hero h1 {
    margin: 0.25rem 0 0.75rem;
  }
  /* Navy on light surfaces: coral on white is 2.5:1 and fails AA for small text.
     The hero override below restores coral, where it sits on navy (6.4:1). */
  .eyebrow {
    text-transform: uppercase;
    letter-spacing: 0.06em;
    font-size: 0.8rem;
    color: var(--brand-primary);
    font-weight: 700;
    margin: 0;
  }
  .lede {
    font-size: 1.2rem;
    color: var(--brand-muted);
    max-width: 62ch;
  }
  .page-body {
    margin-top: 2.5rem;
    max-width: 72ch;
  }
  .page-body h2 {
    margin-top: 2rem;
  }
  .areas-line {
    color: var(--brand-muted);
  }
  .intro-line {
    font-size: 1.15rem;
    font-weight: 600;
    color: var(--brand-text);
  }

  /* ───────────── Buttons ───────────── */
  .button {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    border: 2px solid transparent;
    border-radius: 8px;
    font-family: var(--font-body);
    font-weight: 700;
    min-height: 48px;
    padding: 0.8rem 1.15rem;
    text-decoration: none;
    line-height: 1.1;
    transition: background-color 0.15s ease, border-color 0.15s ease, color 0.15s ease;
  }
  /* Primary: coral surface, NAVY label. White-on-coral is only 2.5:1 — never use it. */
  .button.primary {
    background: var(--brand-secondary);
    color: var(--brand-primary);
  }
  .button.primary:hover {
    background: var(--brand-secondary-dark);
  }
  .button.secondary {
    background: var(--brand-white);
    color: var(--brand-primary);
    border-color: var(--brand-border);
  }
  .button.secondary:hover {
    border-color: var(--brand-primary);
    background: var(--brand-tint);
  }
  .button.outline {
    border-color: var(--brand-primary);
    color: var(--brand-primary);
  }
  .button.outline:hover {
    background: var(--brand-primary);
    color: var(--brand-white);
  }
  /* Legacy .cta still styled in case any page uses it. */
  .cta {
    display: inline-block;
    margin-top: 1rem;
    background: var(--brand-primary);
    color: var(--brand-white);
    text-decoration: none;
    padding: 0.8rem 1.25rem;
    border-radius: 8px;
    font-weight: 700;
  }
  .cta:hover {
    background: var(--brand-primary-dark);
  }
  .hero-actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
    margin-top: 1.5rem;
  }

  /* ───────────── Homepage hero ───────────── */
  .hero {
    background: linear-gradient(135deg, var(--brand-primary-dark), var(--brand-primary));
    color: var(--brand-white);
    padding: clamp(3.5rem, 8vw, 6.5rem) clamp(1.1rem, 4vw, 3.5rem);
  }
  .hero-content {
    max-width: 820px;
    margin: 0 auto;
  }
  .hero .eyebrow {
    color: var(--brand-secondary);
  }
  .hero h1 {
    color: var(--brand-white);
    margin: 0.5rem 0 1rem;
  }
  .lead {
    color: rgba(255, 255, 255, 0.9);
    font-size: clamp(1.05rem, 2vw, 1.35rem);
    max-width: 60ch;
    margin: 0;
  }
  .hero-strip {
    display: grid;
    gap: 0.75rem;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    margin-top: clamp(2rem, 5vw, 3.5rem);
  }
  .hero-strip span {
    background: rgba(255, 255, 255, 0.1);
    border: 1px solid rgba(255, 255, 255, 0.18);
    border-radius: 8px;
    color: var(--brand-white);
    font-weight: 700;
    font-size: 0.92rem;
    padding: 0.85rem;
  }

  /* ───────────── Sections ───────────── */
  .section {
    padding: clamp(3rem, 7vw, 6rem) clamp(1.1rem, 4vw, 3.5rem);
  }
  .section.alt {
    background: var(--brand-tint);
  }
  .section-heading {
    max-width: 760px;
    margin: 0 auto 1.75rem;
  }
  .section-heading h2 {
    margin: 0.25rem 0 0.5rem;
  }
  .section-heading p {
    color: var(--brand-muted);
    margin: 0;
  }

  /* ───────────── Card grids ───────────── */
  .card-grid {
    display: grid;
    gap: 1.1rem;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    max-width: 1200px;
    margin: 0 auto;
  }
  .service-card,
  .city-card,
  .proof-card {
    background: var(--brand-white);
    border: 1px solid var(--brand-border);
    border-radius: 8px;
    box-shadow: var(--shadow);
    padding: 1.4rem;
    text-decoration: none;
    color: inherit;
    transition: transform 0.15s ease, border-color 0.15s ease;
  }
  .service-card:hover,
  .city-card:hover {
    transform: translateY(-2px);
    border-color: var(--brand-primary);
  }
  .service-card h3,
  .city-card h3 {
    margin: 0 0 0.4rem;
  }
  .service-card p,
  .city-card p {
    color: var(--brand-muted);
    margin: 0 0 0.75rem;
    font-size: 0.95rem;
  }
  .service-card span {
    color: var(--brand-primary);
    font-weight: 700;
    font-size: 0.9rem;
  }
  .testimonial-grid {
    grid-template-columns: repeat(3, minmax(0, 1fr));
  }
  .proof-card {
    margin: 0;
  }
  .proof-card p {
    margin: 0 0 1rem;
    font-size: 1.02rem;
  }
  .proof-card cite {
    color: var(--brand-primary-dark);
    font-weight: 700;
    font-style: normal;
  }

  /* ───────────── Numbered + check lists ───────────── */
  .number-list {
    counter-reset: steps;
    display: grid;
    gap: 1rem;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    list-style: none;
    margin: 0 auto;
    padding: 0;
    max-width: 1200px;
  }
  .number-list li {
    counter-increment: steps;
    background: var(--brand-white);
    border: 1px solid var(--brand-border);
    border-radius: 8px;
    padding: 1.2rem;
  }
  .number-list li::before {
    content: counter(steps);
    display: inline-flex;
    align-items: center;
    justify-content: center;
    background: var(--brand-primary);
    color: var(--brand-white);
    border-radius: 999px;
    font-weight: 700;
    height: 30px;
    width: 30px;
    margin-bottom: 0.75rem;
  }
  .number-list h3 {
    font-size: 1.1rem;
    margin: 0 0 0.35rem;
  }
  .number-list p {
    color: var(--brand-muted);
    margin: 0;
    font-size: 0.95rem;
  }
  .check-list {
    list-style: none;
    display: grid;
    gap: 0.6rem;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    margin: 1.25rem 0 0;
    padding: 0;
  }
  .check-list li {
    background: var(--brand-white);
    border: 1px solid var(--brand-border);
    border-radius: 8px;
    padding: 0.85rem 1rem 0.85rem 2.2rem;
    position: relative;
  }
  .check-list li::before {
    content: '✓';
    position: absolute;
    left: 0.85rem;
    color: var(--brand-primary);
    font-weight: 700;
  }
  .pill-list {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    list-style: none;
    margin: 1rem 0 0;
    padding: 0;
  }
  .pill-list li {
    background: var(--brand-tint);
    border-radius: 999px;
    padding: 0.45rem 0.9rem;
    font-size: 0.9rem;
    font-weight: 600;
    color: var(--brand-primary-dark);
  }

  /* ───────────── Service page flow ───────────── */
  .service-hero .hero-trust {
    display: grid;
    gap: 0.6rem;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    list-style: none;
    margin: 1.5rem 0 0;
    padding: 0;
  }
  .service-hero .hero-trust li {
    background: var(--brand-white);
    border: 1px solid var(--brand-border);
    border-radius: 8px;
    color: var(--brand-primary-dark);
    font-weight: 700;
    font-size: 0.9rem;
    padding: 0.7rem 0.85rem;
  }
  .service-flow {
    display: grid;
    gap: clamp(2rem, 4vw, 3rem);
    margin-top: 2.5rem;
  }
  .service-section {
    max-width: 1000px;
  }
  .service-section > h2 {
    margin-bottom: 0.75rem;
  }
  .copy-stack {
    display: grid;
    gap: 0.9rem;
    margin-top: 0.75rem;
  }
  .copy-stack p {
    font-size: 1.05rem;
    color: var(--brand-text);
    margin: 0;
  }
  .detail-grid {
    display: grid;
    gap: 1rem;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    margin-top: 1.25rem;
  }
  .detail-card {
    background: var(--brand-white);
    border: 1px solid var(--brand-border);
    border-radius: 8px;
    box-shadow: var(--shadow);
    padding: 1.2rem;
  }
  .detail-card h3 {
    font-size: 1.05rem;
    margin: 0 0 0.6rem;
  }
  .detail-card ul {
    display: grid;
    gap: 0.4rem;
    margin: 0;
    padding-left: 1.1rem;
  }
  .detail-card li {
    color: var(--brand-muted);
  }
  .warning-section {
    background: var(--brand-white);
    border: 1px solid rgba(255, 127, 80, 0.4);
    border-left: 4px solid var(--brand-secondary);
    border-radius: 8px;
    padding: 1.25rem 1.4rem;
  }
  /* Coral stays as the left rule (decorative); the heading itself is navy for contrast. */
  .warning-section h3 {
    margin: 0 0 0.5rem;
    color: var(--brand-primary);
  }
  .warning-section p {
    margin: 0;
    color: var(--brand-muted);
  }
  .problem-grid {
    display: grid;
    gap: 1rem;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    margin-top: 1.25rem;
  }
  .problem-card {
    background: var(--brand-white);
    border: 1px solid var(--brand-border);
    border-radius: 8px;
    box-shadow: var(--shadow);
    padding: 1.2rem;
  }
  .problem-card h3 {
    color: var(--brand-primary);
    font-size: 0.78rem;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    margin: 0 0 0.25rem;
  }
  .problem-card h3:nth-of-type(2) {
    margin-top: 0.75rem;
  }
  .problem-card p {
    margin: 0;
    color: var(--brand-muted);
  }

  /* ───────────── FAQ ───────────── */
  .faq-list {
    display: grid;
    gap: 0.75rem;
    max-width: 940px;
    margin: 0 auto;
  }
  .faq-block {
    max-width: none;
    margin-top: 2.5rem;
  }
  details {
    background: var(--brand-white);
    border: 1px solid var(--brand-border);
    border-radius: 8px;
    padding: 1.1rem 1.25rem;
  }
  summary {
    cursor: pointer;
    font-weight: 700;
    font-size: 1.05rem;
  }
  details p {
    color: var(--brand-muted);
    margin: 0.75rem 0 0;
  }

  /* ───────────── CTA band ───────────── */
  .cta-band {
    background: var(--brand-primary-dark);
    color: var(--brand-white);
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 1.5rem;
    padding: clamp(2.25rem, 5vw, 3.5rem) clamp(1.1rem, 4vw, 3.5rem);
    margin-top: 3rem;
    border-radius: 8px;
  }
  .cta-band h2 {
    color: var(--brand-white);
    margin: 0 0 0.35rem;
  }
  .cta-band p {
    color: rgba(255, 255, 255, 0.82);
    margin: 0;
  }

  /* ───────────── Sticky mobile bar ───────────── */
  .mobile-sticky {
    display: none;
  }

  /* ───────────── Responsive ───────────── */
  @media (max-width: 900px) {
    .hero-strip,
    .card-grid,
    .number-list,
    .check-list,
    .detail-grid,
    .problem-grid,
    .testimonial-grid,
    .service-hero .hero-trust {
      grid-template-columns: 1fr 1fr;
    }
    .cta-band {
      flex-direction: column;
      align-items: flex-start;
    }
  }
  @media (max-width: 600px) {
    .hero-strip,
    .card-grid,
    .number-list,
    .check-list,
    .detail-grid,
    .problem-grid,
    .testimonial-grid,
    .service-hero .hero-trust {
      grid-template-columns: 1fr;
    }
    .hero-actions .button {
      width: 100%;
    }
    .mobile-sticky {
      position: fixed;
      bottom: 0;
      left: 0;
      right: 0;
      z-index: 20;
      display: grid;
      grid-template-columns: 1fr 1fr;
      gap: 0.5rem;
      padding: 0.6rem;
      background: var(--brand-white);
      border-top: 1px solid var(--brand-border);
    }
    .mobile-sticky a {
      text-align: center;
      font-weight: 700;
      padding: 0.75rem;
      border-radius: 8px;
      text-decoration: none;
      background: var(--brand-primary);
      color: var(--brand-white);
    }
    .mobile-sticky a:last-child {
      background: var(--brand-secondary);
      color: var(--brand-primary);
    }
    main {
      padding-bottom: 4rem;
    }
  }
</style>
