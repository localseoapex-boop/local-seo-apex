---
/**
 * CityLayout.astro — template for /locations/[city] pages.
 *
 * Data-driven from a Location object. Builds the city hero, breadcrumbs, the
 * market's unique intro + positioning + neighborhoods, links across to the
 * canonical /services/[service] pages, and nearby-market links. The serving
 * office's phone is resolved via officeId so the CTA is locally relevant.
 *
 * The body copy comes from the Location, never from a template string with the
 * city name interpolated — five near-identical city pages would be thin content.
 */
import BaseLayout from './BaseLayout.astro';
import Breadcrumbs from '../components/Breadcrumbs.astro';
import InternalLinks from '../components/InternalLinks.astro';
import type { Location } from '../data/locations';
import { getOffice, primaryOffice } from '../data/offices';
import { servicesForLocation, nearbyCities } from '../lib/links';
import { cityUrl, serviceUrl, contactUrl } from '../lib/urls';

interface Props {
  location: Location;
}

const { location } = Astro.props;
const office = getOffice(location.officeId) ?? primaryOffice;
const cityState = `${location.city}, ${location.region}`;

const title = `Digital Marketing in ${cityState}`;
const description = `Local SEO, website development, PPC management, and Google Business Profile optimization for home service businesses in ${cityState}.`;

const crumbs = [
  { name: 'Home', href: '/' },
  { name: 'Areas We Serve', href: '/locations' },
  { name: cityState },
];

// Services this city offers -> the canonical service pages. There are no
// per-city service pages; /services/[service] is the single URL for each.
const serviceLinks = servicesForLocation(location).map((s) => ({
  label: s.name,
  href: serviceUrl(s.slug),
  description: s.tagline,
}));

// Nearby cities for lateral internal linking.
const nearbyLinks = nearbyCities(location.slug).map((loc) => ({
  label: `Digital marketing in ${loc.city}, ${loc.region}`,
  href: cityUrl(loc.slug),
}));
---

<BaseLayout {title} {description}>
  <article class="container page">
    <Breadcrumbs items={crumbs} />

    <header class="page-hero">
      <p class="eyebrow">Serving {cityState}</p>
      <h1>{title}</h1>
      <p class="lede">{location.intro ?? description}</p>
      <div class="hero-actions">
        <a class="button primary" href={contactUrl('strategy')}>Schedule a Strategy Call</a>
        <a class="button outline" href="/services">View all services</a>
      </div>
    </header>

    <div class="page-body">
      {location.positioning && <p>{location.positioning}</p>}
      {location.neighborhoods && location.neighborhoods.length > 0 && (
        <p class="areas-line">
          <strong>Areas we help {location.city} clients rank in:</strong>{' '}
          {location.neighborhoods.join(' · ')}
        </p>
      )}
    </div>

    <InternalLinks title={`Services in ${location.city}`} links={serviceLinks} />
    <InternalLinks title="Nearby areas we serve" links={nearbyLinks} />

    <section class="cta-band">
      <div>
        <h2>Want more booked jobs in {location.city}?</h2>
        <p>Book a strategy call and we will show you where the leads are leaking.</p>
      </div>
      <a class="button primary" href={`tel:${office.phone}`}>Call {office.phoneDisplay}</a>
    </section>
  </article>
</BaseLayout>
