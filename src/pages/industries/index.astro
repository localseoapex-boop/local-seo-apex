 * Placeholder for now: breadcrumb parent and landing surface. Industry links
 * get added once the industry pages exist.
 */
import BaseLayout from '../../layouts/BaseLayout.astro';
import Breadcrumbs from '../../components/Breadcrumbs.astro';
---

<BaseLayout
  title="Industries"
