---
/**
 * /blog/[...slug] — dynamic route for every blog post.
 *
 * getStaticPaths() reads the blog collection and emits one page per non-draft
 * entry, using the entry `id` as the URL slug. `render(post)` compiles the
 * Markdown body into a <Content /> component, which we drop into BlogPostLayout.
 *
 * Add a .md file to src/content/blog and its page appears here automatically —
 * no new route file, validated against the schema at build time.
 *
 * There are currently ZERO posts, so this route generates no pages and the build
 * warns that the `blog` collection is empty. That is expected. The /blog hub
 * page was removed rather than ship an empty listing for Google to index, so
 * re-add src/pages/blog/index.astro (and the nav links in config/site.ts) at the
 * same time as the first real article.
 */
import { getCollection, render } from 'astro:content';
import BlogPostLayout from '../../layouts/BlogPostLayout.astro';

export async function getStaticPaths() {
  const posts = await getCollection('blog', ({ data }) => !data.draft);
  return posts.map((post) => ({
    params: { slug: post.id },
    props: { post },
  }));
}

const { post } = Astro.props;
const { Content } = await render(post);
const { title, description, pubDate, author, heroImage } = post.data;
---

<BlogPostLayout
  {title}
  {description}
  pubDate={pubDate.toISOString().slice(0, 10)}
  {author}
  image={heroImage}
>
  <Content />
</BlogPostLayout>
