---
/**
 * / — Local SEO Apex homepage.
 *
 * Positioning rule: we sell business outcomes (calls, booked jobs, revenue),
 * not services. Local SEO, websites, GBP, and PPC are the tools, so every
 * headline and CTA leads with the outcome and names the tool second.
 *
 * The service grid reads from data/services.ts and the industry grid from
 * data/industries.ts, so the homepage, the /services hub, and the /industries
 * hub can never drift apart. Remaining section content lives in the arrays below
 * so each section is a single map(). Once these repeat on other pages, the card
 * grids should move to components.
 */
import BaseLayout from '../layouts/BaseLayout.astro';
import ServiceIcon from '../components/ServiceIcon.astro';
import { SITE, BUSINESS } from '../config/site';
import { services } from '../data/services';
import { industries } from '../data/industries';
import { serviceUrl } from '../lib/urls';

const principles = [
  {
    title: 'SEO-first website architecture',
    text: 'Structure, internal linking, metadata, schema, and page speed are planned before a single design choice. Retrofitting SEO onto a finished site costs more and works worse.',
  },
  {
    title: 'Local search expertise',
    text: 'Ranking in a city is a different problem than ranking nationally. Proximity, categories, reviews, and local relevance drive the map results, and we work all four.',
  },
  {
    title: 'Built for home service businesses',
    text: 'We do not split our attention across ecommerce, SaaS, and restaurants. We know what an HVAC lead costs, what a roofing sales cycle looks like, and which searches actually book.',
  },
  {
    title: 'Systems instead of tactics',
    text: 'A blog post here and a Google Ads campaign there will not compound. Your site, your profile, your content, and your paid search should feed each other.',
  },
  {
    title: 'Data-driven decisions',
    text: 'We track calls, forms, and booked jobs back to the source. When something is not producing revenue, we change it or stop paying for it.',
  },
  {
    title: 'AI where it creates real value',
    text: 'We use AI to speed up research, analysis, and reporting. We do not use it to publish thin content that Google and your customers can both spot.',
  },
];

/** Placeholder shells. Swap the copy once real results are cleared for publication. */
const proofCards = [
  {
    title: 'Case studies',
    text: 'Full breakdowns of the starting point, the work, the timeline, and the lead volume it produced. Publishing soon.',
  },
  {
    title: 'Client results',
    text: 'Ranking, call, and booked job data from live campaigns, shared with client permission. Publishing soon.',
  },
  {
    title: 'Testimonials',
    text: 'Owners and marketing managers describing what changed in their business after the work. Publishing soon.',
  },
];

const packages = [
  {
    title: 'Local SEO',
    priceNote: 'a custom monthly retainer',
    text: 'Best for companies that want steady, compounding lead flow in their service area.',
    includes: [
      'Local keyword and competitor research',
      'On-page and technical SEO',
      'Google Business Profile optimization',
      'Local content and location pages',
      'Call and lead tracking',
    ],
  },
  {
    title: 'SEO-First Website',
    priceNote: 'a fixed project quote',
    text: 'Best for companies whose current site is slow, dated, or does not turn visitors into calls.',
    includes: [
      'Site architecture and page mapping',
      'Custom design and build',
      'Speed and Core Web Vitals work',
      'Schema and technical foundation',
      'Conversion-focused page copy',
    ],
  },
  {
    title: 'PPC Management',
    priceNote: 'a monthly fee plus ad spend',
    text: 'Best for companies that need qualified calls now while their organic rankings build.',
    includes: [
      'Campaign build and keyword strategy',
      'Landing pages built to convert',
      'Negative keyword and waste control',
      'Bid and budget management',
      'Cost per booked job reporting',
    ],
  },
];

const faqs = [
  {
    question: 'How long does it take to see results from Local SEO?',
    answer:
      'Most home service companies start to see movement in rankings and calls within a few months, and the results keep building from there. The timeline depends on how competitive your city is, how strong your website is today, and how established your Google Business Profile already is. Anyone promising you page one in 30 days is guessing.',
  },
  {
    question: 'Should I start with SEO or PPC?',
    answer:
      'It depends on how fast you need the phone to ring. PPC can generate calls in days but the leads stop the moment you stop paying. SEO takes longer to build but the traffic keeps coming without a per-click cost. Most owners we talk to run paid search for immediate work while SEO builds underneath it.',
  },
  {
    question: 'Do you only work with home service companies?',
    answer:
      'Yes. HVAC, plumbing, electrical, garage doors, roofing, landscaping, insulation, and related trades. Focusing on one type of business means we already know your buyer, your seasonality, and which searches turn into booked jobs instead of learning it on your budget.',
  },
  {
    question: 'Do I need a new website, or can you work with the one I have?',
    answer:
      'We can often work with your current site. If it loads fast, is built on a platform we can properly optimize, and already converts visitors, a rebuild is wasted money. If the structure fights against search or visitors leave without calling, we will tell you that plainly and show you why.',
  },
  {
    question: 'How do you measure whether the marketing is working?',
    answer:
      'By calls, form submissions, and booked jobs, tracked back to the channel that produced them. Rankings and traffic are useful signals, but they are not the point. If traffic goes up and your calendar does not, something is wrong and we go fix it.',
  },
];

const faqSchema = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: faqs.map((f) => ({
    '@type': 'Question',
    name: f.question,
    acceptedAnswer: { '@type': 'Answer', text: f.answer },
  })),
};
---

<BaseLayout title="Digital Marketing for Home Service Companies" description={SITE.description}>
  <section class="hero">
    <div class="hero-content">
      <p class="eyebrow">Digital Marketing for Home Service Companies</p>
      <h1>More Qualified Leads for Your Home Service Business</h1>
      <p class="lead">
        Local SEO Apex helps HVAC, plumbing, electrical, roofing, and other home service companies
        get found by the customers who are ready to book. Local SEO, an SEO-first website, Google
        Business Profile, PPC, and AI-powered marketing systems work together so your phone rings
        with better leads.
      </p>
      <div class="hero-actions">
        <a class="button primary" href="/contact">Schedule a Strategy Call</a>
        <a class="button secondary" href="/contact">Get a Free SEO Audit</a>
      </div>
      <div class="hero-strip">
        <span>Local SEO</span>
        <span>SEO-First Websites</span>
        <span>Google Business Profile</span>
        <span>PPC Management</span>
      </div>
    </div>
  </section>

  <section class="section">
    <div class="section-heading">
      <p class="eyebrow">Services</p>
      <h2>Four tools. One outcome: more booked jobs.</h2>
      <p>
        No owner wakes up wanting SEO. You want a full schedule and work that pays. These are the
        levers we pull to get you there.
      </p>
    </div>

    <div class="card-grid">
      {services.map((service) => (
        <article class="service-card">
          <ServiceIcon name={service.icon} class="card-icon" />
          <h3><a href={serviceUrl(service.slug)}>{service.name}</a></h3>
          <p class="outcome">{service.tagline}</p>
          <p>{service.intro}</p>
        </article>
      ))}
    </div>
  </section>

  <section class="section alt">
    <div class="section-heading">
      <p class="eyebrow">Industries</p>
      <h2>We know your trade before the first call</h2>
      <p>
        A roofing customer and a plumbing customer search differently, decide differently, and are
        worth different amounts. An agency that treats them the same wastes your budget learning what
        we already know.
      </p>
    </div>

    <div class="card-grid">
      {industries.map((industry) => (
        <article class="city-card">
          <h3>{industry.name}</h3>
          <p>{industry.cardText}</p>
        </article>
      ))}
    </div>

    <p class="section-link"><a href="/industries">See all industries we serve →</a></p>
  </section>

  <section class="section">
    <div class="section-heading">
      <p class="eyebrow">Why Local SEO Apex</p>
      <h2>Principles, not promises</h2>
      <p>
        Plenty of agencies will show you a dashboard full of green arrows. Here is how we actually
        work and what we will not do.
      </p>
    </div>

    <ol class="number-list why-list">
      {principles.map((principle) => (
        <li>
          <h3>{principle.title}</h3>
          <p>{principle.text}</p>
        </li>
      ))}
    </ol>
  </section>

  <section class="section alt">
    <div class="section-heading">
      <p class="eyebrow">Proof</p>
      <h2>Results, published as they are cleared</h2>
      <p>
        We would rather show you nothing than show you numbers we cannot back up. Real case studies
        and client results go here as campaigns mature and clients approve the details.
      </p>
    </div>

    <div class="card-grid testimonial-grid">
      {proofCards.map((card) => (
        <article class="proof-card">
          <h3>{card.title}</h3>
          <p>{card.text}</p>
        </article>
      ))}
    </div>
  </section>

  <section class="section">
    <div class="section-heading">
      <p class="eyebrow">Pricing</p>
      <h2>What working together looks like</h2>
      <p>
        Every market and every website is different, so we quote after we understand your situation.
        Here is what each engagement includes.
      </p>
    </div>

    <div class="card-grid pricing-grid">
      {packages.map((pkg) => (
        <article class="detail-card">
          <h3>{pkg.title}</h3>
          <p class="price-label">Starting at</p>
          <p class="price-value">{pkg.priceNote}</p>
          <p class="price-text">{pkg.text}</p>
          <ul>
            {pkg.includes.map((item) => <li>{item}</li>)}
          </ul>
        </article>
      ))}
    </div>
  </section>

  <section class="section alt">
    <div class="section-heading">
      <p class="eyebrow">FAQ</p>
      <h2>What owners ask before they hire us</h2>
    </div>

    <div class="faq-list">
      {faqs.map((f) => (
        <details>
          <summary>{f.question}</summary>
          <p>{f.answer}</p>
        </details>
      ))}
    </div>
  </section>

  <section class="cta-band">
    <div>
      <h2>Let's talk about your lead flow</h2>
      <p>
        A 30 minute strategy call. We will look at where you rank today, what your competitors are
        doing, and where the fastest wins are. No pressure and no obligation.
      </p>
    </div>
    <a class="button primary" href="/contact">Schedule a Strategy Call</a>
  </section>

  <div class="mobile-sticky">
    <a href={`tel:${BUSINESS.phone}`}>Call now</a>
    <a href="/contact">Strategy Call</a>
  </div>

  <script type="application/ld+json" set:html={JSON.stringify(faqSchema)} is:inline />
</BaseLayout>

<style>
  /* Outcome line sits above the explanation so the benefit reads first. */
  .service-card .outcome {
    color: var(--green-dark);
    font-weight: 700;
    font-size: 0.95rem;
    margin: 0 0 0.6rem;
  }

  /* Six principles read better as 3x2 than the global 4-column default. */
  .why-list {
    grid-template-columns: repeat(3, minmax(0, 1fr));
  }

  .pricing-grid {
    grid-template-columns: repeat(3, minmax(0, 1fr));
  }
  .price-label {
    color: var(--muted);
    font-size: 0.8rem;
    font-weight: 800;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    margin: 0;
  }
  .price-value {
    color: var(--green-dark);
    font-size: 1.15rem;
    font-weight: 800;
    margin: 0 0 0.75rem;
  }
  .price-text {
    color: var(--muted);
    font-size: 0.95rem;
    margin: 0 0 1rem;
  }

  .proof-card h3 {
    margin: 0 0 0.5rem;
  }
  .proof-card p {
    color: var(--muted);
  }

  .section-link {
    max-width: 1200px;
    margin: 1.75rem auto 0;
    font-weight: 800;
  }
  .section-link a {
    text-decoration: none;
  }

  @media (max-width: 900px) {
    .why-list,
    .pricing-grid {
      grid-template-columns: 1fr 1fr;
    }
  }
  @media (max-width: 600px) {
    .why-list,
    .pricing-grid {
      grid-template-columns: 1fr;
    }
  }
</style>
