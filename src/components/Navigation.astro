---
/**
 * Navigation.astro — site header + primary nav.
 *
 * Pulls links from NAV_LINKS so the menu is edited in one place. Highlights the
 * active link by comparing each href against the current path (good for UX and
 * gives crawlers clear, consistent internal linking). A prominent "Call" CTA is
 * standard for home-service sites where phone calls are the main conversion.
 *
 * DROPDOWNS are built from the SAME data the routes are generated from
 * (services + subServicesForCategory, serviceAreaLocations), so a menu entry
 * cannot point at a route that does not exist. Never hardcode these URLs.
 *
 * Industries has NO dropdown on purpose: every entry in data/industries.ts is
 * `hasPage: false` and there is no /industries/[industry] route, so a submenu
 * would link to 404s. Flip those to true, add the route, then add the submenu.
 */
import { SITE, BUSINESS, NAV_LINKS } from '../config/site';
import { services } from '../data/services';
import { serviceAreaLocations, subServicesForCategory } from '../lib/links';
import { serviceUrl, subServiceUrl, cityUrl } from '../lib/urls';

const currentPath = Astro.url.pathname;
const isActive = (href: string) =>
  href === '/' ? currentPath === '/' : currentPath.startsWith(href.split('/').slice(0, 2).join('/'));

/** Grouped Services menu: each category, then the sub-services beneath it. */
const serviceGroups = services.map((service) => ({
  name: service.name,
  href: serviceUrl(service.slug),
  children: subServicesForCategory(service.slug).map((sub) => ({
    name: sub.name,
    href: subServiceUrl(service.slug, sub.slug),
  })),
}));

/**
 * Flat Locations menu, one entry per city page that actually builds.
 *
 * Location has NO `name` field. It carries `city` + `region`, so the label is
 * composed the same way the /locations hub composes it. Reading a non-existent
 * property here renders an EMPTY anchor, which looks exactly like a CSS colour
 * bug and is not one.
 */
const locationLinks = serviceAreaLocations.map((loc) => ({
  name: `${loc.city}, ${loc.region}`,
  href: cityUrl(loc.slug),
}));

/** Which top-level items own a dropdown, keyed by their NAV_LINKS href. */
const MENUS: Record<string, { id: string; kind: 'services' | 'locations' }> = {
  '/services': { id: 'menu-services', kind: 'services' },
  '/locations': { id: 'menu-locations', kind: 'locations' },
};
---

<header class="site-header">
  <nav class="nav" aria-label="Primary">
    <a href="/" class="brand">
      {/* alt doubles as the link's accessible name, so no extra sr-only text is needed. */}
      <img
        src="/brand/local-seo-apex-logo.png"
        alt={SITE.name}
        width="250"
        height="120"
        class="brand-logo"
        fetchpriority="high"
      />
    </a>

    {/* Mobile only. Collapses the whole nav so the sticky header stays compact
        instead of shipping a 1000px wall of links above every page. */}
    <button
      type="button"
      class="nav-burger"
      aria-expanded="false"
      aria-controls="primary-nav"
      aria-label="Open navigation menu"
    >
      <svg class="icon-open" viewBox="0 0 20 20" aria-hidden="true" focusable="false">
        <path d="M2 5h16M2 10h16M2 15h16" stroke="currentColor" stroke-width="2" stroke-linecap="round" />
      </svg>
      <svg class="icon-close" viewBox="0 0 20 20" aria-hidden="true" focusable="false">
        <path d="M4 4l12 12M16 4L4 16" stroke="currentColor" stroke-width="2" stroke-linecap="round" />
      </svg>
    </button>

    <div class="nav-panel" id="primary-nav">
      <ul class="nav-links">
      {
        NAV_LINKS.map((link) => {
          const menu = MENUS[link.href];
          if (!menu) {
            return (
              <li>
                <a href={link.href} aria-current={isActive(link.href) ? 'page' : undefined}>
                  {link.label}
                </a>
              </li>
            );
          }
          return (
            <li class="has-menu">
              {/* The parent stays a real link. A SEPARATE button owns the disclosure,
                  so keyboard and screen-reader users can reach /services and /locations
                  themselves instead of the parent being hijacked into a toggle. */}
              <span class="nav-item">
                <a href={link.href} aria-current={isActive(link.href) ? 'page' : undefined}>
                  {link.label}
                </a>
                <button
                  type="button"
                  class="menu-toggle"
                  aria-expanded="false"
                  aria-controls={menu.id}
                  aria-label={`Show ${link.label} menu`}
                >
                  <svg viewBox="0 0 10 6" aria-hidden="true" focusable="false">
                    <path d="M1 1l4 4 4-4" fill="none" stroke="currentColor" stroke-width="1.6" />
                  </svg>
                </button>
              </span>

              <ul class="menu" id={menu.id}>
                {menu.kind === 'services'
                  ? serviceGroups.map((group) => (
                      <li class="menu-group">
                        <a class="menu-parent" href={group.href}>
                          {group.name}
                        </a>
                        {group.children.length > 0 && (
                          <ul class="menu-children">
                            {group.children.map((child) => (
                              <li>
                                <a href={child.href}>{child.name}</a>
                              </li>
                            ))}
                          </ul>
                        )}
                      </li>
                    ))
                  : locationLinks.map((loc) => (
                      <li>
                        <a class="menu-link" href={loc.href}>
                          {loc.name}
                        </a>
                      </li>
                    ))}
              </ul>
            </li>
          );
        })
      }
      </ul>
    </div>

    <a class="cta" href={`tel:${BUSINESS.phone}`}>Call {BUSINESS.phoneDisplay}</a>
  </nav>
</header>

<style>
  .site-header {
    border-bottom: 1px solid var(--brand-border);
    background: rgba(255, 255, 255, 0.94);
    backdrop-filter: saturate(180%) blur(6px);
    position: sticky;
    top: 0;
    z-index: 10;
  }
  .nav {
    max-width: 1100px;
    margin: 0 auto;
    padding: 0.75rem 1rem;
    display: flex;
    align-items: center;
    gap: 1.5rem;
  }
  .brand {
    display: flex;
    align-items: center;
    text-decoration: none;
    flex-shrink: 0;
  }
  /* width/height attrs on the <img> lock the 250x120 aspect ratio, so scaling by
     height alone reserves the right box up front and causes no layout shift. */
  .brand-logo {
    display: block;
    height: 44px;
    width: auto;
  }
  @media (max-width: 640px) {
    .brand-logo {
      height: 36px;
    }
  }
  .nav-links {
    display: flex;
    align-items: center;
    gap: 1.25rem;
    list-style: none;
    margin: 0;
    padding: 0;
    margin-left: auto;
  }
  .nav-links > li > a,
  .nav-item > a {
    color: var(--brand-muted);
    text-decoration: none;
    font-size: 0.95rem;
    font-weight: 700;
  }
  .nav-links > li > a:hover,
  .nav-item > a:hover,
  .nav-links a[aria-current='page'] {
    color: var(--brand-primary);
  }

  /* ───────────── Dropdowns ───────────── */
  .has-menu {
    position: relative;
  }
  .nav-item {
    display: inline-flex;
    align-items: center;
    gap: 0.15rem;
  }
  .menu-toggle {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    background: none;
    border: 0;
    padding: 0.25rem;
    cursor: pointer;
    color: var(--brand-muted);
    border-radius: 4px;
    line-height: 0;
  }
  .menu-toggle svg {
    width: 10px;
    height: 6px;
    transition: transform 0.15s ease;
  }
  .has-menu:hover .menu-toggle,
  .menu-toggle[aria-expanded='true'] {
    color: var(--brand-primary);
  }
  .menu-toggle[aria-expanded='true'] svg {
    transform: rotate(180deg);
  }

  .menu {
    position: absolute;
    top: calc(100% + 0.5rem);
    left: 0;
    z-index: 20;
    min-width: 250px;
    margin: 0;
    padding: 0.6rem;
    list-style: none;
    background: var(--brand-white);
    border: 1px solid var(--brand-border);
    border-radius: 8px;
    box-shadow: var(--shadow);
    /* Hidden from mouse, keyboard AND assistive tech until opened. */
    display: none;
  }
  /* Hover opens for pointer users. Keyboard opening is driven by the script via
     .is-open, NOT by :focus-within: :focus-within cannot be cancelled, so Escape
     could not close a panel while focus remained on the toggle inside it, and the
     visible state would drift out of sync with aria-expanded. */
  .has-menu.is-open .menu {
    display: block;
  }
  /* Hover opening is DESKTOP ONLY. Unscoped, a touch tap leaves :hover latched on
     mobile and the accordion can never be closed again. */
  @media (min-width: 901px) {
    .has-menu:hover .menu {
      display: block;
    }
    /* Bridges the gap between trigger and panel so the pointer can travel down. */
    .has-menu:hover .menu::before,
    .has-menu.is-open .menu::before {
      content: '';
      position: absolute;
      top: -0.5rem;
      left: 0;
      right: 0;
      height: 0.5rem;
    }
  }
  .menu a {
    display: block;
    padding: 0.4rem 0.6rem;
    border-radius: 6px;
    color: var(--brand-text);
    text-decoration: none;
    font-size: 0.9rem;
    font-weight: 400;
  }
  .menu a:hover,
  .menu a:focus-visible {
    background: var(--brand-tint);
    color: var(--brand-primary);
  }
  .menu-group + .menu-group {
    margin-top: 0.35rem;
  }
  .menu-parent {
    font-weight: 700 !important;
    color: var(--brand-primary) !important;
  }
  .menu-children {
    list-style: none;
    margin: 0;
    padding: 0 0 0 0.6rem;
  }
  .menu-children a {
    color: var(--brand-muted);
    font-size: 0.85rem;
  }
  /* Location links: navy on the white panel (16:1).
     MUST be qualified as `.menu a.menu-link`, not a bare `.menu-link`. Astro scopes
     `.menu a` to `.menu[cid] a[cid]` (specificity 0,3,1), which outranks a lone
     `.menu-link[cid]` (0,2,0) and silently keeps the colour at --brand-text. */
  .menu a.menu-link {
    color: var(--brand-primary);
    font-weight: 600;
  }
  .menu a.menu-link:hover,
  .menu a.menu-link:focus-visible {
    background: var(--brand-tint);
    color: var(--brand-primary);
  }
  /* Coral surface, navy label — never white-on-coral (2.5:1). */
  .cta {
    background: var(--brand-secondary);
    color: var(--brand-primary);
    text-decoration: none;
    padding: 0.55rem 0.95rem;
    border-radius: 8px;
    font-size: 0.9rem;
    font-weight: 700;
    white-space: nowrap;
    transition: background-color 0.15s ease;
  }
  .cta:hover {
    background: var(--brand-secondary-dark);
  }
  /* Hamburger. Hidden on desktop, where the dropdown bar is the navigation. */
  .nav-burger {
    display: none;
    align-items: center;
    justify-content: center;
    width: 44px;
    height: 44px;
    padding: 0;
    background: none;
    border: 1px solid var(--brand-border);
    border-radius: 8px;
    color: var(--brand-primary);
    cursor: pointer;
  }
  .nav-burger svg {
    width: 20px;
    height: 20px;
  }
  /* aria-expanded is the single source of truth for the open/close glyph, so the
     icon can never disagree with what assistive tech is told. */
  .nav-burger[aria-expanded='false'] .icon-close,
  .nav-burger[aria-expanded='true'] .icon-open {
    display: none;
  }
  .nav-burger[aria-expanded='true'] {
    background: var(--brand-tint);
  }

  /* ───────────── Mobile: collapsed drawer + accordions ─────────────
     Below 900px the header row stays compact (logo, call CTA, hamburger). The nav
     is an absolutely positioned drawer, so an open menu never inflates the sticky
     header. Services and Locations collapse into accordions driven by the SAME
     .menu-toggle buttons the desktop dropdowns use. */
  @media (max-width: 900px) {
    .nav {
      flex-wrap: nowrap;
      gap: 0.6rem;
    }
    .brand {
      order: 1;
      margin-right: auto;
    }
    .cta {
      order: 2;
    }
    .nav-burger {
      display: inline-flex;
      order: 3;
    }

    .nav-panel {
      display: none;
      position: absolute;
      top: 100%;
      left: 0;
      right: 0;
      background: var(--brand-white);
      border-top: 1px solid var(--brand-border);
      box-shadow: var(--shadow);
      padding: 0.5rem 1rem 1.25rem;
      /* The drawer scrolls itself rather than the page behind it. */
      max-height: calc(100vh - 100%);
      overflow-y: auto;
      overscroll-behavior: contain;
    }
    .nav-panel.is-open {
      display: block;
    }

    .nav-links {
      margin-left: 0;
      width: 100%;
      flex-direction: column;
      align-items: stretch;
      gap: 0.15rem;
    }
    .has-menu {
      position: static;
    }
    .nav-item {
      display: flex;
      align-items: center;
      justify-content: space-between;
      gap: 0.5rem;
    }
    .nav-links > li > a,
    .nav-item > a {
      display: block;
      padding: 0.6rem 0;
      font-size: 1rem;
      flex: 1 1 auto;
    }
    /* A real 44px touch target, and it stays a SEPARATE control from the parent
       link so /services and /locations remain independently tappable. */
    .menu-toggle {
      display: inline-flex;
      flex: 0 0 auto;
      width: 44px;
      height: 44px;
      border-radius: 8px;
    }
    .menu-toggle svg {
      width: 12px;
      height: 8px;
    }

    /* Accordion panels: collapsed by default, opened only via .is-open. */
    .menu {
      display: none;
      position: static;
      min-width: 0;
      border: 0;
      box-shadow: none;
      background: transparent;
      padding: 0 0 0.5rem 0.75rem;
      border-left: 2px solid var(--brand-border);
      margin: 0 0 0.35rem 0.15rem;
    }
    .menu a {
      padding: 0.5rem;
    }
  }
</style>

<style is:global>
  /* Scroll lock while the mobile drawer is open. The drawer is an overlay, so the
     page behind it must not scroll away underneath the user. */
  body.nav-locked {
    overflow: hidden;
  }
</style>

<script>
  // Progressive enhancement.
  //
  // DESKTOP (>900px): CSS :hover already opens the dropdowns with zero JS. This adds
  // the disclosure state (aria-expanded), open-on-keyboard-focus, and Escape.
  //
  // MOBILE (<=900px): the hamburger owns a collapsed drawer, and the same
  // .menu-toggle buttons act as accordion disclosures inside it. Only one accordion
  // is open at a time. Escape closes the open accordion FIRST, then the drawer.
  const DESKTOP = window.matchMedia('(min-width: 901px)');

  const header = document.querySelector<HTMLElement>('.site-header');
  const burger = document.querySelector<HTMLButtonElement>('.nav-burger');
  const panel = document.querySelector<HTMLElement>('#primary-nav');
  const items = Array.from(document.querySelectorAll<HTMLElement>('.has-menu'));

  // Escape marks an item dismissed so the focusin handler does not instantly reopen
  // the panel it just closed (focus is still sitting on the toggle at that point).
  const dismissed = new WeakSet<HTMLElement>();
  const toggleOf = (item: HTMLElement) => item.querySelector<HTMLButtonElement>('.menu-toggle');

  const closeSub = (item: HTMLElement) => {
    item.classList.remove('is-open');
    toggleOf(item)?.setAttribute('aria-expanded', 'false');
  };

  const openSub = (item: HTMLElement) => {
    // One submenu at a time: opening Services closes Locations, and vice versa.
    items.forEach((other) => other !== item && closeSub(other));
    item.classList.add('is-open');
    toggleOf(item)?.setAttribute('aria-expanded', 'true');
  };

  const openSubmenu = () => items.find((i) => i.classList.contains('is-open')) ?? null;

  const drawerOpen = () => panel?.classList.contains('is-open') ?? false;

  const closeDrawer = () => {
    panel?.classList.remove('is-open');
    burger?.setAttribute('aria-expanded', 'false');
    burger?.setAttribute('aria-label', 'Open navigation menu');
    document.body.classList.remove('nav-locked');
    items.forEach(closeSub);
  };

  const openDrawer = () => {
    panel?.classList.add('is-open');
    burger?.setAttribute('aria-expanded', 'true');
    burger?.setAttribute('aria-label', 'Close navigation menu');
    document.body.classList.add('nav-locked');
  };

  burger?.addEventListener('click', () => {
    drawerOpen() ? closeDrawer() : openDrawer();
  });

  items.forEach((item) => {
    const toggle = toggleOf(item);
    if (!toggle) return;

    // Enter and Space both fire click on a <button>, so this covers both.
    toggle.addEventListener('click', () => {
      if (toggle.getAttribute('aria-expanded') === 'true') {
        dismissed.add(item);
        closeSub(item);
      } else {
        dismissed.delete(item);
        openSub(item);
      }
    });

    // Desktop only: dropdowns open on keyboard focus, not just on click.
    item.addEventListener('focusin', () => {
      if (!DESKTOP.matches || dismissed.has(item)) return;
      openSub(item);
    });

    item.addEventListener('focusout', (event) => {
      if (!DESKTOP.matches) return;
      const next = (event as FocusEvent).relatedTarget as Node | null;
      if (!next || !item.contains(next)) {
        dismissed.delete(item); // leaving the item resets the dismissal
        closeSub(item);
      }
    });
  });

  // Escape is handled ONCE, here. Putting it on the items too would close the
  // submenu and then let the same keystroke bubble up and close the drawer as well.
  document.addEventListener('keydown', (event) => {
    if ((event as KeyboardEvent).key !== 'Escape') return;

    const open = openSubmenu();
    if (open) {
      dismissed.add(open);
      closeSub(open);
      toggleOf(open)?.focus();
      return;
    }

    if (drawerOpen()) {
      closeDrawer();
      burger?.focus();
    }
  });

  // Clicking away should not leave anything stuck open.
  document.addEventListener('click', (event) => {
    const target = event.target as Node | null;
    if (!target) return;

    items.forEach((item) => {
      if (!item.contains(target)) closeSub(item);
    });

    if (drawerOpen() && header && !header.contains(target)) closeDrawer();
  });

  // Rotating a phone to landscape can cross the breakpoint. Reset to a clean
  // desktop state so a leftover scroll lock or open drawer cannot strand the page.
  DESKTOP.addEventListener('change', (event) => {
    if (event.matches) closeDrawer();
  });
</script>
