---
/**
 * Navigation.astro — site header + primary nav.
 *
 * Pulls links from NAV_LINKS so the menu is edited in one place. Highlights the
 * active link by comparing each href against the current path (good for UX and
 * gives crawlers clear, consistent internal linking). A prominent "Call" CTA is
 * standard for home-service sites where phone calls are the main conversion.
 */
import { SITE, BUSINESS, NAV_LINKS } from '../config/site';

const currentPath = Astro.url.pathname;
const isActive = (href: string) =>
  href === '/' ? currentPath === '/' : currentPath.startsWith(href.split('/').slice(0, 2).join('/'));
---

<header class="site-header">
  <nav class="nav" aria-label="Primary">
    <a href="/" class="brand">
      {/* alt doubles as the link's accessible name, so no extra sr-only text is needed. */}
      <img
        src="/brand/local-seo-apex-logo.png"
        alt={SITE.name}
        width="250"
        height="120"
        class="brand-logo"
        fetchpriority="high"
      />
    </a>

    <ul class="nav-links">
      {
        NAV_LINKS.map((link) => (
          <li>
            <a href={link.href} aria-current={isActive(link.href) ? 'page' : undefined}>
              {link.label}
            </a>
          </li>
        ))
      }
    </ul>

    <a class="cta" href={`tel:${BUSINESS.phone}`}>Call {BUSINESS.phoneDisplay}</a>
  </nav>
</header>

<style>
  .site-header {
    border-bottom: 1px solid var(--brand-border);
    background: rgba(255, 255, 255, 0.94);
    backdrop-filter: saturate(180%) blur(6px);
    position: sticky;
    top: 0;
    z-index: 10;
  }
  .nav {
    max-width: 1100px;
    margin: 0 auto;
    padding: 0.75rem 1rem;
    display: flex;
    align-items: center;
    gap: 1.5rem;
  }
  .brand {
    display: flex;
    align-items: center;
    text-decoration: none;
    flex-shrink: 0;
  }
  /* width/height attrs on the <img> lock the 250x120 aspect ratio, so scaling by
     height alone reserves the right box up front and causes no layout shift. */
  .brand-logo {
    display: block;
    height: 44px;
    width: auto;
  }
  @media (max-width: 640px) {
    .brand-logo {
      height: 36px;
    }
  }
  .nav-links {
    display: flex;
    gap: 1.25rem;
    list-style: none;
    margin: 0;
    padding: 0;
    margin-left: auto;
  }
  .nav-links a {
    color: var(--brand-muted);
    text-decoration: none;
    font-size: 0.95rem;
    font-weight: 700;
  }
  .nav-links a:hover,
  .nav-links a[aria-current='page'] {
    color: var(--brand-primary);
  }
  /* Coral surface, navy label — never white-on-coral (2.5:1). */
  .cta {
    background: var(--brand-secondary);
    color: var(--brand-primary);
    text-decoration: none;
    padding: 0.55rem 0.95rem;
    border-radius: 8px;
    font-size: 0.9rem;
    font-weight: 700;
    white-space: nowrap;
    transition: background-color 0.15s ease;
  }
  .cta:hover {
    background: var(--brand-secondary-dark);
  }
  @media (max-width: 640px) {
    .nav {
      flex-wrap: wrap;
      gap: 0.75rem;
    }
    .nav-links {
      margin-left: 0;
      order: 3;
      width: 100%;
    }
  }
</style>
