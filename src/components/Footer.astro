---
/**
 * Footer.astro — site footer with a NAP block PER office (requirement #5).
 *
 * Iterates offices.ts so every physical location shows its own address and
 * phone in a semantic <address> element. This mirrors the multi-node
 * LocalBusiness schema exactly — consistent NAP across page + schema + external
 * listings is a core local-SEO ranking factor.
 */
import { SITE, FOOTER_LINKS } from '../config/site';
import { offices } from '../data/offices';

const year = new Date().getFullYear();
---

<footer class="site-footer">
  <div class="footer-inner">
    <div class="footer-brand-col">
      <img
        src="/brand/local-seo-apex-logo.png"
        alt={SITE.name}
        width="250"
        height="120"
        class="footer-logo"
        loading="lazy"
      />
      <p class="footer-tagline">{SITE.description}</p>
    </div>

    {
      offices.map((office) => (
        <div class="footer-office">
          <p class="footer-heading">{office.name}</p>
          <address>
            {office.address.street && (
              <>
                {office.address.street}
                <br />
              </>
            )}
            {office.address.city}, {office.address.region}
            {office.address.postalCode ? ` ${office.address.postalCode}` : ''}
            <br />
            <a href={`tel:${office.phone}`}>{office.phoneDisplay}</a>
          </address>
        </div>
      ))
    }

    {
      FOOTER_LINKS.map((group) => (
        <nav class="footer-group" aria-label={group.title}>
          <p class="footer-heading">{group.title}</p>
          <ul>
            {group.links.map((link) => (
              <li>
                <a href={link.href}>{link.label}</a>
              </li>
            ))}
          </ul>
        </nav>
      ))
    }
  </div>

  <p class="footer-legal">
    &copy; {year} {offices[0].legalName}. All rights reserved.
  </p>
</footer>

<style>
  /* Light surface by design: the brand logo is dark-on-transparent and there is no
     reversed/knockout variant, so a dark footer would need a filter or a plaque.
     Adjusting the surface keeps the logo pixel-accurate. Revisit if a reversed
     logo is supplied. --brand-footer (#575860) carries the text at 7.1:1. */
  .site-footer {
    position: relative;
    background: linear-gradient(180deg, var(--brand-surface-2), var(--brand-white) 55%);
    border-top: 1px solid var(--brand-border);
    color: var(--brand-footer);
    margin-top: 0;
  }
  /* Thin coral top-accent ties the footer to the single brand accent. */
  .site-footer::before {
    content: '';
    position: absolute;
    top: -1px;
    left: 0;
    right: 0;
    height: 3px;
    background: linear-gradient(90deg, var(--brand-secondary), var(--brand-secondary-dark) 60%, transparent);
  }
  .footer-inner {
    max-width: var(--wide-width);
    margin: 0 auto;
    padding: 3.5rem 1rem 1.75rem;
    display: grid;
    grid-template-columns: 1.4fr repeat(auto-fit, minmax(160px, 1fr));
    gap: 2.5rem;
  }
  .footer-brand-col {
    min-width: 220px;
  }
  .footer-logo {
    display: block;
    height: 52px;
    width: auto;
    margin: 0 0 0.75rem;
  }
  .footer-tagline {
    margin: 0;
    font-size: 0.9rem;
    line-height: 1.6;
    color: var(--brand-footer);
  }
  address {
    font-style: normal;
    line-height: 1.7;
    font-size: 0.9rem;
  }
  .footer-heading {
    font-family: var(--font-body);
    text-transform: uppercase;
    letter-spacing: 0.1em;
    font-size: 0.76rem;
    font-weight: 700;
    color: var(--brand-primary);
    margin: 0 0 1rem;
  }
  .footer-group ul {
    list-style: none;
    margin: 0;
    padding: 0;
    line-height: 2.1;
  }
  .site-footer a {
    color: var(--brand-footer);
    text-decoration: none;
    background-image: linear-gradient(var(--brand-primary), var(--brand-primary));
    background-size: 0% 1.5px;
    background-position: 0 100%;
    background-repeat: no-repeat;
    transition: background-size var(--dur-2) var(--ease-out), color var(--dur-1) var(--ease-out);
  }
  .site-footer a:hover {
    color: var(--brand-primary);
    background-size: 100% 1.5px;
  }
  .footer-legal {
    max-width: 1100px;
    margin: 0 auto;
    padding: 1.5rem 1rem;
    border-top: 1px solid var(--brand-border);
    font-size: 0.85rem;
    color: var(--brand-muted);
  }
</style>
